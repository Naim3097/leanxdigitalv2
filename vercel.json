{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/og-image.png",
      "destination": "/og/default.png",
      "permanent": true
    },
    {
      "source": "/services/google-ads/",
      "destination": "/services/paid-advertising/",
      "permanent": true
    },
    {
      "source": "/services/facebook-ads/",
      "destination": "/services/paid-advertising/",
      "permanent": true
    },
    {
      "source": "/products/byki/",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/products/scopie/",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/products/nexops/",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/products/discova/",
      "destination": "/products/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
