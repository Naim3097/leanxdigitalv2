---
// A dark section with a grid of name cards. On hover (wide screens), the card face slides up and a
// second face with an accent border slides in. The second face is drawn from data-label, so each name
// appears once in the page text. A short last row is centred.
interface Props {
  title: string;
  id: string;
  note?: string;
  items: readonly string[];
}
const { title, id, note, items } = Astro.props;
---

<section class="section section-dark dark-grid" data-surface="dark" aria-labelledby={id}>
  <div class="container">
    <div class="intro">
      <h2 id={id} data-split>{title}</h2>
      {note && <p>{note}</p>}
    </div>
    <ul class="grid">
      {
        items.map((item) => (
          <li>
            <span class="face">{item}</span>
            <span class="face face-alt" aria-hidden="true" data-label={item} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  li {
    flex: 0 0 calc((100% - 1rem) / 2);
    position: relative;
    height: 5.25rem;
    overflow: hidden;
    border: 1px solid var(--dark-line);
    border-radius: var(--radius-s);
    background: rgb(255 255 255 / 0.03);
  }

  @media (min-width: 48rem) {
    li {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }

  @media (min-width: 64rem) {
    li {
      flex-basis: calc((100% - 3rem) / 4);
    }
  }

  .face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    color: var(--on-dark);
    font-size: var(--fs-large);
    font-weight: 500;
    text-align: center;
    transition: transform 0.6s var(--ease-out);
  }

  .face-alt::before {
    content: attr(data-label);
  }

  .face-alt {
    border: 1px solid var(--select-bg);
    border-radius: inherit;
    color: var(--select-bg);
    transform: translateY(101%);
  }

  @media (hover: hover) {
    li:hover .face:not(.face-alt) {
      transform: translateY(-101%);
    }

    li:hover .face-alt {
      transform: none;
    }
  }
</style>
