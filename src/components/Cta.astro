---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  /** WhatsApp link pre-filled for the page's topic. */
  whatsapp?: string;
}
const { whatsapp = site.whatsapp } = Astro.props;
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-panel">
      <div class="cta-bg" aria-hidden="true"></div>
      <div class="intro">
        <h2 id="cta-title" data-split>Tell us what you sell and what isn’t working.</h2>
        <p>
          WhatsApp us your business name and a link to your website or shop. We reply in English or
          Bahasa Malaysia, whichever is easier for you.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={whatsapp} data-magnetic>
            <Icon name="chat" />
            {/* One element for the words, so they can wrap beside the icon on narrow screens or large text */}
            <span>WhatsApp <span class="nowrap">{site.phoneDisplay}</span></span>
          </a>
          <a class="btn btn-secondary" href={`mailto:${site.email}`} data-magnetic>
            <Icon name="mail" />
            Email us
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--section-s);
    background: var(--page);
  }

  .cta-panel {
    position: relative;
    padding: clamp(3.5rem, 2rem + 6vw, 7.5rem) clamp(1.25rem, 1rem + 3vw, 4rem);
    border-radius: var(--radius-xl);
    isolation: isolate;
  }

  /* The moving mesh lives in its own clipped layer. The heading stays outside any overflow container,
     so its scroll-linked reveal keeps following the page, and the wide mesh never widens the page. */
  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
  }

  .cta-bg::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 220%;
    background: var(--mesh);
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 45%, rgb(255 255 255 / 0.55), transparent 70%);
  }

  .intro > p {
    color: var(--text);
  }

  @media (max-width: 30rem) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .actions .btn {
      white-space: normal;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .cta-bg::before {
      animation: mesh-drift 18s ease-in-out infinite alternate;
    }

    @keyframes mesh-drift {
      to {
        transform: translateX(-54%);
      }
    }
  }
</style>
