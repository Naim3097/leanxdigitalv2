---
import Logo from './Logo.astro';
import { site, fullAddress } from '../data/site';
import { products } from '../data/products';
import { services } from '../data/services';
import { hasPublicFile } from '../lib/files';

const year = new Date().getFullYear();
const showPdf = hasPublicFile(site.companyProfilePdf);
const company = site.legalName || site.name;
const reg = site.registrationNumber ? ` (${site.registrationNumber})` : '';
const copyright = `© ${year} ${company}${reg}. Kuala Lumpur, Malaysia.`;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <Logo />
          <span>lean.x digital</span>
        </a>
        <address>{fullAddress}</address>
      </div>

      <nav aria-labelledby="footer-products">
        <h2 id="footer-products">Product</h2>
        <ul>
          {
            products.map((p) => (
              <li>
                <a href={`/products/${p.slug}/`}>{p.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-services">
        <h2 id="footer-services">Services</h2>
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`}>{s.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-company">
        <h2 id="footer-company">Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          {
            showPdf && (
              <li>
                <a href={site.companyProfilePdf}>Company profile (PDF)</a>
              </li>
            )
          }
        </ul>
      </nav>

      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={site.whatsapp}>WhatsApp {site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.social.instagram} rel="me">Instagram</a></li>
          <li><a href={site.social.facebook} rel="me">Facebook</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>{copyright}</p>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>
