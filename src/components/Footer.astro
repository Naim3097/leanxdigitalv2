---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { site, fullAddress } from '../data/site';
import { products } from '../data/products';
import { services } from '../data/services';
import { hasPublicFile } from '../lib/files';
import { visibleCaseStudies } from '../data/work';

interface Props {
  /** WhatsApp link pre-filled for the page's topic. */
  whatsapp?: string;
}
const { whatsapp = site.whatsapp } = Astro.props;
const year = new Date().getFullYear();
const showPdf = hasPublicFile(site.companyProfilePdf);
const company = site.legalName || site.name;
const reg = site.registrationNumber ? ` (${site.registrationNumber})` : '';
const copyright = `© ${year} ${company}${reg}. Kuala Lumpur, Malaysia.`;
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand footer-logo" href="/" aria-label={`${site.name} home`}>
          <Wordmark />
        </a>
        <p class="footer-tagline">{site.tagline}</p>
        <div class="footer-contact">
          <div>
            <p class="eyebrow">Email</p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div>
            <p class="eyebrow">Phone and WhatsApp</p>
            <a class="nowrap" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          </div>
        </div>
        {
          showPdf && (
            <a class="btn btn-primary btn-sm footer-pdf" href={site.companyProfilePdf}>
              <Icon name="download" />
              Company profile (PDF)
            </a>
          )
        }
      </div>

      <div class="footer-cols">
        <nav aria-labelledby="footer-products">
          <h2 id="footer-products">Product</h2>
          <ul>
            {
              products.map((p) => (
                <li>
                  <a href={`/products/${p.slug}/`} data-roll>
                    {p.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-services">
          <h2 id="footer-services">Services</h2>
          <ul>
            {
              services.map((s) => (
                <li>
                  <a href={`/services/${s.slug}/`} data-roll>
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-company">
          <h2 id="footer-company">Company</h2>
          <ul>
            <li><a href="/about/" data-roll>About</a></li>
            {visibleCaseStudies.length > 0 && <li><a href="/work/" data-roll>Work</a></li>}
            <li><a href="/contact/" data-roll>Contact</a></li>
            {
              showPdf && (
                <li>
                  <a href={site.companyProfilePdf}>Company profile (PDF)</a>
                </li>
              )
            }
          </ul>
        </nav>

        <div>
          <h2>Contact</h2>
          <ul>
            <li><a href={whatsapp}>WhatsApp <span class="nowrap">{site.phoneDisplay}</span></a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.social.instagram} rel="me" data-roll>Instagram</a></li>
            <li><a href={site.social.facebook} rel="me" data-roll>Facebook</a></li>
            {
              site.social.linkedin && (
                <li>
                  <a href={site.social.linkedin} rel="me" data-roll>
                    LinkedIn
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-office">
      <span class="icon-tile"><Icon name="pin" /></span>
      <div>
        <p class="eyebrow">Our office</p>
        <address>{fullAddress}</address>
      </div>
    </div>
  </div>

  <div class="footer-base" data-surface="dark">
    <div class="container">
      <p>{copyright}</p>
      <button class="motion-toggle" type="button" hidden>Pause animations</button>
      <p>{site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper);
    font-size: var(--fs-small);
  }

  .footer > .container {
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem) clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .footer-top {
    display: grid;
    gap: 3rem;
  }

  /* The brand block sits beside the link columns only once there is room for both */
  @media (min-width: 90rem) {
    .footer-top {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
    }
  }

  .footer-brand {
    display: grid;
    justify-items: start;
    gap: 1.75rem;
  }

  .footer-logo :global(.wordmark) {
    height: 2rem;
  }

  @media (min-width: 48rem) {
    .footer-logo :global(.wordmark) {
      height: 2.5rem;
    }
  }

  .footer-tagline {
    max-width: 14ch;
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
  }

  .footer-contact .eyebrow {
    margin-bottom: 0.25rem;
  }

  .footer-contact a {
    display: inline-block;
    padding-block: 0.3rem;
    font-weight: 500;
    text-decoration: none;
  }

  .footer-contact a:hover {
    text-decoration: underline;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }

  /* On phones the contact column takes the full width, so the email address fits on one line */
  .footer-cols > div:last-child {
    grid-column: 1 / -1;
  }

  /* The contact column is as wide as its longest entry, so the number and the email stay whole */
  @media (min-width: 48rem) {
    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr)) max-content;
    }

    .footer-cols > div:last-child {
      grid-column: auto;
    }
  }

  .footer h2 {
    margin-bottom: 1rem;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .footer-cols a {
    display: inline-block;
    padding-block: 0.375rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-subtle);
    text-decoration: none;
    transition: color var(--fast);
  }

  .footer-cols a:hover {
    color: var(--text-3);
  }

  .footer-office {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .footer-office address {
    margin-top: 0.25rem;
    font-style: normal;
    color: var(--text-2);
  }

  .footer-base {
    background: var(--dark);
    color: var(--on-dark-2);
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  /* The bottom padding keeps the copyright clear of the nav pill at every width */
  .footer-base .container {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem calc(1.5rem + 5.5rem);
  }

  .footer-base p {
    margin: 0;
  }

  /* Stops everything that moves on its own, site-wide (scripts/site.ts) */
  .motion-toggle {
    min-height: 1.75rem;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .motion-toggle[hidden] {
    display: none;
  }

  .motion-toggle:hover {
    color: var(--on-dark);
  }
</style>
