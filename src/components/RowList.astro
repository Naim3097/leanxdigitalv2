---
// Numbered rows linking to product, service or case study pages. Build items with productRows(),
// serviceRows() or workRows(). The whole row is the link; styles (and the hover) live in global.css (.rows).
import type { Row } from '../lib/rows';

interface Props {
  items: Row[];
}
const { items } = Astro.props;
---

<ol class="rows">
  {
    items.map((r, i) => (
      <li>
        <a href={r.href}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class="name">
            <strong>{r.name}</strong>
            <span>{r.label}</span>
          </span>
          <span class="text">{r.text}</span>
        </a>
      </li>
    ))
  }
</ol>
