---
import '@fontsource-variable/geist/wght.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import { site, absoluteUrl } from '../data/site';
import { organization, website } from '../lib/schema';
import { showDrafts } from '../lib/drafts';
import { isPreview } from '../lib/deploy';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  cta?: boolean;
  /** WhatsApp link for this page's call to action and footer, pre-filled for the page's topic. */
  whatsapp?: string;
}

const {
  title,
  description,
  image = '/og/default.png',
  imageAlt = `${site.name}. ${site.tagline}`,
  schema = [],
  noindex = false,
  cta = true,
  whatsapp = site.whatsapp,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization(), website(), ...schema],
};
---

<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={isPreview
        ? 'noindex, nofollow'
        : noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="geo.region" content="MY-14" />
    <meta name="geo.placename" content="Kuala Lumpur" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      site.ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(site.ga4Id)});`}
          />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {
      showDrafts && (
        <a class="draft-bar" href="/drafts/">
          Preview: drafts are shown here and hidden on the live site. See everything waiting for review
        </a>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    {cta && <Cta whatsapp={whatsapp} />}
    <Footer whatsapp={whatsapp} />
  </body>
</html>
