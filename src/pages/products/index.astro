---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Features from '../../components/Features.astro';
import Label from '../../components/Label.astro';
import DraftNote from '../../components/DraftNote.astro';
import NexovaStage from '../../components/NexovaStage.astro';
import { site } from '../../data/site';
import { showDrafts } from '../../lib/drafts';
import { products } from '../../data/products';
import { updatedFor } from '../../data/pages';
import { webPage, breadcrumbs, productList } from '../../lib/schema';
import { countWord, listOf } from '../../lib/text';
import { featureIcons } from '../../lib/icons';

const path = '/products/';
const count = countWord(products.length);
const names = listOf(products.map((p) => p.name));
const title = `Products: ${names} | ${site.name}`;
const description =
  'Nexova, from Lean X Digital: a store website that grows itself, with auto content, auto Meta ads and auto SEO, and stock synced to Shopee and TikTok Shop.';
const crumbs: [string, string][] = [
  ['Home', '/'],
  ['Products', path],
];

const schema = [
  webPage({
    path,
    title,
    description,
    updated: updatedFor(path),
    type: 'CollectionPage',
    hasBreadcrumb: true,
  }),
  breadcrumbs(path, crumbs),
  productList(path),
];

// NexovaStage draws the first product (Nexova) as a stage; any other product gets a plain section.
const staged = products[0]?.slug;
---

<Base title={title} description={description} schema={schema}>
  <header class="page-head products-head">
    <div class="glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <Label icon="store">{products.length === 1 ? 'Our product' : `${count} products`}</Label>
      <h1>Products</h1>
      <p class="lede">
        Lean X Digital makes {names}, a store website that grows itself. On its own, it runs the same content, Meta ads
        and SEO workflows our team uses with clients. You run the shop.
      </p>
      {
        showDrafts && (
          <div class="head-draft">
            <DraftNote label="Draft: merge proposal, for your decision">
              <p>
                With one product, this page repeats the {products[0].name} page. The strategy report suggests merging it
                into that page and redirecting /products/ there. Keep it if more products are coming soon, and give it a
                more descriptive H1 than “Products”.
              </p>
            </DraftNote>
          </div>
        )
      }
    </div>
  </header>

  <div class="lineup">
    {
      products.map((p, i) => {
        const n = String(i + 1).padStart(2, '0');
        return p.slug === staged ? (
          <NexovaStage intro eyebrow={`${n} · ${p.category}`} titleId={`${p.slug}-title`} />
        ) : (
          <section class="section product" aria-labelledby={`${p.slug}-title`}>
            <div class="container">
              <div class="intro">
                <Label icon="store">
                  {n} · {p.category}
                </Label>
                <h2 id={`${p.slug}-title`} class="product-name" data-split>
                  <a href={`/products/${p.slug}/`}>{p.name}</a>
                </h2>
                <p>{p.definition}</p>
                <div class="actions">
                  <a class="btn btn-primary" href={`/products/${p.slug}/`} data-magnetic>
                    About {p.name}
                  </a>
                  {p.website && (
                    <a class="btn btn-secondary" href={p.website.url} rel="noopener" data-magnetic>
                      {p.website.label}
                    </a>
                  )}
                </div>
              </div>
              <h3 class="product-sub">What {p.name} does</h3>
              <Features items={p.features} level="h4" icons={featureIcons} />
            </div>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  /* The product line-up rises over the bottom of the page head as a sheet with rounded top corners */
  .products-head {
    padding-bottom: calc(clamp(3.5rem, 2rem + 4vw, 6rem) + clamp(1.5rem, 1rem + 2vw, 3rem));
  }

  .head-draft {
    justify-self: stretch;
    width: 100%;
    max-width: var(--measure-4);
    margin: 0.5rem auto 0;
  }

  .lineup {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * clamp(1.5rem, 1rem + 2vw, 3rem));
  }

  .lineup :global(.nexova-intro) {
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  @media (max-width: 47.99rem) {
    .lineup :global(.nexova-intro) {
      border-radius: var(--radius-m) var(--radius-m) 0 0;
    }
  }

  /* Any further product: a centred intro, then its features as icon cards */
  .product + .product {
    border-top: 1px solid var(--line);
  }

  .product-name a {
    text-decoration: none;
  }

  .product-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .product-sub {
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 1.5rem;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    text-align: center;
  }
</style>
