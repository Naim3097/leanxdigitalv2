---
import Base from '../../layouts/Base.astro';
import { showDrafts } from '../../lib/drafts';
import { draftPages, draftSections } from '../../data/review';

// Local preview only: every draft page and section waiting for the owner's review.
export function getStaticPaths() {
  return showDrafts ? [{ params: { page: undefined } }] : [];
}
---

<Base
  title="Drafts for review"
  description="Draft pages and sections waiting for review. Local preview only."
  noindex
  cta={false}
>
  <header class="page-head wrap">
    <p class="eyebrow">Local preview only</p>
    <h1>Drafts for review</h1>
    <p class="lede">
      Nothing on this list appears on the live site. Each item says what it needs from you before it can go live.
    </p>
  </header>

  <section class="section" aria-labelledby="pages-title">
    <div class="wrap section-grid">
      <div class="section-head">
        <h2 id="pages-title">Draft pages</h2>
        <p>New pages, built only in local preview.</p>
      </div>
      <dl class="facts">
        {
          draftPages.map((d) => (
            <div>
              <dt>
                <a href={d.path}>{d.name}</a>
              </dt>
              <dd>{d.needs}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="sections-title">
    <div class="wrap section-grid">
      <div class="section-head">
        <h2 id="sections-title">Draft sections on live pages</h2>
        <p>Each is marked with a dashed box on its page.</p>
      </div>
      <dl class="facts">
        {
          draftSections.map((d) => (
            <div>
              <dt>
                <a href={d.path}>{d.name}</a>
              </dt>
              <dd>{d.needs}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>
