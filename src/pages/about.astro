---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RowList from '../components/RowList.astro';
import Facts from '../components/Facts.astro';
import DarkGrid from '../components/DarkGrid.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Label from '../components/Label.astro';
import DraftNote from '../components/DraftNote.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { site, fullAddress, formatDate } from '../data/site';
import { products } from '../data/products';
import { services, people, hasProfilePage } from '../data/services';
import { updatedFor } from '../data/pages';
import { webPage, breadcrumbs, person } from '../lib/schema';
import { productRows, serviceRows } from '../lib/rows';
import { showDrafts } from '../lib/drafts';

const path = '/about/';
const updated = updatedFor(path);
const nexova = products[0];
const title = `About ${site.name} | Digital solutions company in Kuala Lumpur`;
const description =
  'Lean X Digital is a Kuala Lumpur company that makes Nexova, a self-growing store website. Our team also does creative work, paid ads, SEO and development for you.';
const crumbs: [string, string][] = [
  ['Home', '/'],
  ['About', path],
];
const ownSites = people.flatMap((m) => (m.ownSite ? [{ person: m, ...m.ownSite }] : []));

const details: [string, string][] = [
  ['Name', site.name],
  ...(site.legalName ? [['Registered name', site.legalName] as [string, string]] : []),
  ...(site.registrationNumber
    ? [['SSM registration', site.registrationNumber] as [string, string]]
    : []),
  ...(site.foundingDate ? [['Founded', site.foundingDate] as [string, string]] : []),
  ['Address', fullAddress],
  ['Phone and WhatsApp', site.phoneDisplay],
  ['Email', site.email],
  ['Languages', 'English and Bahasa Malaysia'],
];

const schema = [
  webPage({ path, title, description, updated, type: 'AboutPage', hasBreadcrumb: true }),
  breadcrumbs(path, crumbs),
  ...people.map(person),
];

// "How we work": the first paragraph is set as a large statement whose words ink in as it scrolls into
// view. The text is the same sentence as before, word for word; the tagline in quotes takes the accent.
const quote = `“${site.tagline}”`.split(' ');
const statement = [
  ...'Our line is'.split(' ').map((w) => ({ w, q: -1 })),
  ...quote.map((w, i) => ({ w, q: quote.length > 1 ? i / (quote.length - 1) : 0 })),
  ...'Traffic is nice. Customers who pay are nicer. So we look at the whole path your customers take: the content they see, the ad or search result they click, and the page or WhatsApp chat where they decide to buy.'
    .split(' ')
    .map((w) => ({ w, q: -1 })),
];

// Team figures, read from each bio so they always match it (decorative; the bio itself is the source).
// A bio that doesn't contain one of these phrases simply shows fewer figures.
type Figure = { icon: IconName; pre?: string; value: string; caption: string };
const numberWords: Record<string, number> = { two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, nine: 9, ten: 10 };
const figuresFrom = (bio: string): Figure[] => {
  const out: Figure[] = [];
  const years = bio.match(/more than (\w+) years/i);
  const y = years ? (numberWords[years[1].toLowerCase()] ?? Number(years[1])) : 0;
  if (y) out.push({ icon: 'clock', value: `${y}+`, caption: 'years of experience' });
  const money = bio.match(/([\w-]+) over RM ([\d.,]+)( million)? in ([a-z ]+?)(?= and\b|[.,])/i);
  if (money) {
    const [, verb, amount, million, what] = money;
    const n = Number(amount.replace(/,/g, ''));
    const value = million ? `RM ${amount}m+` : n >= 1000 ? `RM ${n / 1000}k+` : `RM ${amount}+`;
    out.push({ icon: 'chart', value, caption: `in ${what}, ${verb}` });
  }
  const accounts = bio.match(/up to (\d+) client accounts (at once|at a time)/i);
  if (accounts) out.push({ icon: 'users', pre: 'Up to', value: accounts[1], caption: `client accounts ${accounts[2]}` });
  return out;
};
// Stand-in for a headshot on the live site until a real photo is supplied: the icon of the person's focus.
const focusIcon = (focus: string): IconName =>
  /creative|meta/i.test(focus) ? 'pen' : /google|seo|search/i.test(focus) ? 'target' : 'users';
---

<Base title={title} description={description} schema={schema}>
  <header class="page-head">
    <div class="glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <Label icon="building">About</Label>
      <h1>About <span class="nowrap">Lean X Digital</span></h1>
      <p class="lede">
        Lean X Digital (written “leanx digital” in our logo) is a digital solutions company in
        <span class="nowrap">Bandar Sri Damansara</span>, <span class="nowrap">Kuala Lumpur</span>. We make {nexova.name}, and our team does the same work for you.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#team" data-magnetic>Meet the team</a>
        <a class="btn btn-secondary" href={`/products/${nexova.slug}/`} data-magnetic>See {nexova.name}</a>
      </div>
    </div>
  </header>

  <section class="section approach" aria-labelledby="approach-title">
    <div class="container approach-inner">
      <Label as="h2" id="approach-title" icon="route" class="approach-label">How we work</Label>
      <p class="statement" style={`--n: ${statement.length}`}>
        {
          statement.map((x, i) => (
            <>
              <span class:list={['w', { q: x.q >= 0 }]} style={x.q >= 0 ? `--i: ${i}; --q: ${x.q}` : `--i: ${i}`}>
                {x.w}
              </span>{' '}
            </>
          ))
        }
      </p>
      <p class="approach-more" data-rise>
        Our strategists built their workflows for that path over years of client work. {nexova.name} runs
        those workflows automatically, as a store website that grows itself. Or pick our services, and
        the team behind those workflows does the work.
      </p>
      <Label as="span" icon="content" class="sticker glass-pill s1" aria-hidden="true">Content</Label>
      <Label as="span" icon="megaphone" class="sticker glass-pill s2" aria-hidden="true">Ads and search</Label>
      <Label as="span" icon="chat" class="sticker glass-pill s3" aria-hidden="true">WhatsApp chats</Label>
    </div>
  </section>

  <section class="section section-white what what-first" aria-labelledby="make-title">
    <div class="container">
      <div class="intro">
        <Label icon="spark">Automated</Label>
        <h2 id="make-title" data-split>Product</h2>
      </div>
      <div class="rows-wrap" data-rise>
        <RowList items={productRows(products)} />
      </div>
    </div>
  </section>

  <section class="section section-white what what-next" aria-labelledby="services-title">
    <div class="container">
      <div class="intro">
        <Label icon="users">Done for you</Label>
        <h2 id="services-title" data-split>Services</h2>
      </div>
      <div class="rows-wrap" data-rise>
        <RowList items={serviceRows(services)} />
      </div>
    </div>
  </section>

  <DarkGrid title="Industries" id="industries-title" note="Sectors our clients work in." items={site.industries} />

  <section class="section team" id="team" aria-labelledby="team-title">
    <div class="container">
      <div class="intro">
        <h2 id="team-title" data-split>Team</h2>
        <p>The strategists who lead our work. Both co-founded {nexova.name}.</p>
      </div>
      <ul class="card-grid card-grid-2 people">
        {
          people.map((m) => {
            const figs = figuresFrom(m.bio);
            const linked = hasProfilePage(m);
            return (
              <li class:list={['card', 'person', { linked }]} id={m.slug} data-rise>
                {m.photo ? (
                  <img class="person-photo" src={m.photo} alt={m.fullName} width="160" height="160" />
                ) : showDrafts ? (
                  <div class="person-slot">
                    <ImageSlot label={`Headshot of ${m.name}, square, at least 800 px`} ratio="3 / 1" />
                  </div>
                ) : (
                  <span class="person-mono" aria-hidden="true">
                    <Icon name={focusIcon(m.focus)} />
                  </span>
                )}
                <p class="eyebrow">{m.focus}</p>
                <h3>{linked ? <a href={`/about/${m.slug}/`}>{m.name}</a> : m.name}</h3>
                <p class="person-bio">
                  <span class="person-role">{m.role}.</span> {m.bio}
                </p>
                {figs.length > 0 && (
                  <div class="figs" aria-hidden="true">
                    {figs.map((f) => (
                      <div class="fig">
                        <span class="fig-mark">
                          <span>[</span>
                          <Icon name={f.icon} />
                          <span>]</span>
                        </span>
                        <span class="fig-num">
                          {f.pre && <span class="fig-pre">{f.pre} </span>}
                          <span data-count>{f.value}</span>
                        </span>
                        <span class="fig-cap">{f.caption}</span>
                      </div>
                    ))}
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
      {
        ownSites.length > 0 && (
          <p class="own-sites">
            Our strategists also share how they work at{' '}
            {ownSites.map((x, i) => (
              <>{i > 0 && (i === ownSites.length - 1 ? ' and ' : ', ')}<a href={x.url} rel="noopener">{x.brand}</a></>
            ))}.{' '}
            {ownSites.map((x) => x.disclaimer).join(' ')}
          </p>
        )
      }
      {
        site.team.length > 0 && (
          <dl class="facts team-list">
            {site.team.map((m) => (
              <div>
                <dt>{m.role}</dt>
                <dd>{m.url ? <a href={m.url}>{m.name}</a> : <strong>{m.name}</strong>}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <section class="section section-white details" id="details" aria-labelledby="details-title">
    <div class="container">
      <div class="intro">
        <h2 id="details-title" data-split>Company details</h2>
        <Label icon="clock">Updated <time datetime={updated}>{formatDate(updated)}</time></Label>
      </div>
      <div data-rise>
        <Facts facts={details} variant="bento" columns={3} />
      </div>
      <div class="actions detail-links">
        <a class="btn btn-primary" href={site.mapUrl} rel="noopener" data-magnetic>
          <Icon name="pin" />
          Open in Google Maps
        </a>
        <a class="btn btn-secondary" href={site.social.instagram} rel="me noopener">Instagram</a>
        <a class="btn btn-secondary" href={site.social.facebook} rel="me noopener">Facebook</a>
        {
          site.social.linkedin && (
            <a class="btn btn-secondary" href={site.social.linkedin} rel="me noopener">
              LinkedIn
            </a>
          )
        }
      </div>
      {
        showDrafts && !(site.legalName && site.registrationNumber && site.foundingDate) && (
          <div class="details-draft">
            <DraftNote>
              <p>
                Missing company details. Add them in <code>src/data/site.ts</code> and they appear here, in the footer,
                in llms.txt and in the structured data:
              </p>
              <ul>
                {!site.legalName && <li>Registered company name, as on the SSM certificate</li>}
                {!site.registrationNumber && <li>SSM registration number</li>}
                {!site.foundingDate && <li>Year the company started</li>}
                {!site.social.linkedin && <li>LinkedIn company page</li>}
                <li>One line on how Lean X Digital relates to Nexova, Lean.x and Leanis, as the strategy report recommends</li>
              </ul>
            </DraftNote>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* How we work: a label-sized heading over a large statement. Clipped with clip-path, not overflow: an
     overflow container would freeze the statement's scroll-linked ink. A faint colour tint behind the
     statement gives the glass pills something to blur. */
  .approach {
    clip-path: inset(0);
    background:
      radial-gradient(40% 50% at 18% 45%, rgb(143 230 244 / 0.18), transparent 70%),
      radial-gradient(40% 50% at 82% 55%, rgb(153 62 255 / 0.12), transparent 70%),
      var(--page);
  }

  .approach-inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    text-align: center;
  }

  .approach-inner :global(.approach-label) {
    line-height: 1.4;
  }

  .statement {
    position: relative;
    z-index: 1;
    /* At 31ch the last line was "to buy." alone; at 30ch it reads "where they decide to buy." */
    max-width: 30ch;
    font-size: var(--fs-statement);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.018em;
    color: var(--ink);
    text-wrap: balance;
  }

  .statement .q {
    color: var(--card-2);
    color: color-mix(in oklch, var(--card-1), var(--card-3) calc(var(--q) * 100%));
  }

  .approach-more {
    position: relative;
    z-index: 1;
    max-width: var(--measure-2);
    margin-top: 0;
    font-size: var(--fs-large);
    letter-spacing: 0;
    color: var(--text-2);
  }

  /* The stickers are glass pills placed around the statement, only where the margins beside it are wide
     enough to keep every pill clear of the words (from 1360 px) */
  .approach-inner :global(.sticker) {
    display: none;
  }

  @media (min-width: 85rem) {
    .approach-inner :global(.sticker) {
      display: inline-flex;
      position: absolute;
      white-space: nowrap;
    }

    .approach-inner :global(.s1) {
      left: 2%;
      top: 26%;
    }

    .approach-inner :global(.s2) {
      right: 1%;
      top: 52%;
    }

    .approach-inner :global(.s3) {
      left: 7%;
      bottom: 12%;
    }
  }

  /* Product and services: one white band, two lists of rows */
  .what-first {
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .what-next {
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  /* Team: one card per strategist */
  .people {
    align-items: stretch;
    max-width: 72rem;
    margin-inline: auto;
  }

  .person {
    gap: 0.875rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .person-slot {
    width: 100%;
    margin-bottom: 0.75rem;
  }

  .person-photo,
  .person-mono {
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
  }

  .person-photo {
    object-fit: cover;
  }

  .person-mono {
    display: grid;
    place-items: center;
    background: linear-gradient(140deg, var(--card-1), var(--card-2) 55%, var(--card-3));
    color: var(--paper);
    box-shadow: var(--shadow-chip);
  }

  .person-mono :global(svg) {
    width: 2rem;
    height: 2rem;
    stroke-width: 1.4;
  }

  .person h3 {
    font-size: var(--fs-h3);
    letter-spacing: -0.02em;
  }

  .person h3 a {
    text-decoration: none;
  }

  /* The name link covers the whole card */
  .person h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .person h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  .person.linked:hover {
    translate: 0 -4px;
    box-shadow: var(--shadow-card);
  }

  .person > .person-bio {
    color: var(--text-2);
  }

  .person-role {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--ink);
  }

  /* Figures from the bio, set like the reference's bracketed proof stats */
  .figs {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr) minmax(0, 0.95fr);
    width: 100%;
    margin-top: auto;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .fig {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.625rem;
    padding-inline: clamp(0.75rem, 0.25rem + 1vw, 1.25rem);
    border-left: 1px solid var(--line);
  }

  .fig:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .fig:last-child {
    padding-right: 0;
  }

  .fig-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-3);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1;
  }

  .fig-mark :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .fig-num {
    font-size: clamp(1.5rem, 1.05rem + 1vw, 2.125rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .fig-pre {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-3);
  }

  .fig-cap {
    font-size: var(--fs-caption);
    line-height: 1.3;
    text-wrap: balance;
    color: var(--text-2);
  }

  @media (max-width: 33.99rem) {
    .figs {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .fig {
      grid-template-columns: 7.25rem 1fr;
      align-items: baseline;
      padding: 0;
      border: 0;
    }

    .fig-mark {
      display: none;
    }
  }

  .own-sites {
    max-width: 48ch;
    text-wrap: balance;
    margin: clamp(2rem, 1.5rem + 2vw, 3rem) auto 0;
    font-size: var(--fs-small);
    color: var(--text-2);
    text-align: center;
  }

  .team-list {
    max-width: var(--measure-3);
    margin: 2rem auto 0;
  }

  /* Company details */

  .details :global(.facts-bento) {
    max-width: 72rem;
    margin-inline: auto;
  }

  .detail-links {
    justify-content: center;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .details-draft {
    max-width: var(--measure-4);
    margin: 2rem auto 0;
  }

  @media (max-width: 30rem) {
    .detail-links {
      flex-direction: column;
      align-items: stretch;
      align-self: stretch;
      justify-self: stretch;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Words ink in as the statement moves up the screen */
      .statement {
        view-timeline-name: --statement;
      }

      .statement .w {
        animation: word-ink linear both;
        animation-timeline: --statement;
        animation-range: cover calc(6% + 40% * var(--i) / var(--n)) cover calc(13% + 40% * var(--i) / var(--n));
      }

      @keyframes word-ink {
        from {
          opacity: 0.14;
        }

        to {
          opacity: 1;
        }
      }

      /* Stickers pop on, one after another */
      .approach {
        view-timeline-name: --approach;
      }

      .approach-inner :global(.sticker) {
        animation: pop linear both;
        animation-timeline: --approach;
      }

      .approach-inner :global(.s1) {
        animation-range: cover 22% cover 28%;
      }

      .approach-inner :global(.s2) {
        animation-range: cover 29% cover 35%;
      }

      .approach-inner :global(.s3) {
        animation-range: cover 36% cover 42%;
      }

      @keyframes pop {
        from {
          opacity: 0;
          transform: translateY(1rem);
          animation-timing-function: var(--ease-out);
        }

        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
</style>
