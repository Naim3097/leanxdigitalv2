---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import DraftNote from '../../components/DraftNote.astro';
import { pageTitle } from '../../data/site';
import { showDrafts } from '../../lib/drafts';
import { services, whatsappUrl } from '../../data/services';
import { products } from '../../data/products';
import { updatedFor } from '../../data/pages';
import { webPage, breadcrumbs, serviceList } from '../../lib/schema';
import { countWord, lcFirst } from '../../lib/text';

const path = '/services/';
const count = countWord(services.length);
const nexova = products[0];
const title = pageTitle('Services: creative, paid ads, SEO and development');
const description =
  'Lean X Digital’s team does the work for you: a creative agency, paid advertising, SEO, and website, CRM and app development for Malaysian businesses.';
const crumbs: [string, string][] = [
  ['Home', '/'],
  ['Services', path],
];

const schema = [
  webPage({
    path,
    title,
    description,
    updated: updatedFor(path),
    type: 'CollectionPage',
    hasBreadcrumb: true,
  }),
  breadcrumbs(path, crumbs),
  serviceList(path),
];
---

<Base title={title} description={description} schema={schema}>
  <Breadcrumbs items={crumbs} />

  <header class="page-head wrap">
    <p class="eyebrow">Done for you</p>
    <h1>Services</h1>
    <p class="lede">
      Our team does the work for you. {count.charAt(0).toUpperCase() + count.slice(1)} services, from the
      same team that builds {nexova.name}.
    </p>
  </header>

  {
    showDrafts && (
      <div class="wrap" style="padding-bottom: 3rem">
        <DraftNote label="Draft: proposed structure, for your decision">
          <p>
            The strategy report suggests ordering the services the way a buyer moves, from traffic to conversion to
            checkout to a store of their own, so the list stops reading like a generalist menu:
          </p>
          <ul>
            <li>Rename Paid advertising to performance marketing, reported in paid orders, and fold Creative agency into it</li>
            <li>
              Split Websites, CRM and apps into own store launch, landing pages and funnels, and checkout and payment
              integration, the last only after the payment lawyer’s answers
            </li>
            <li>Reframe SEO as search and AI visibility for online stores, at a lower priority</li>
            <li>Give the page a more descriptive H1 than “Services”, once you have keyword data</li>
          </ul>
          <p>Renamed pages change URLs. Before launch that costs nothing; after launch each one needs a redirect.</p>
        </DraftNote>
      </div>
    )
  }

  {
    services.map((s, i) => (
      <section class="section" aria-labelledby={`${s.slug}-title`}>
        <div class="wrap section-grid">
          <div class="section-head">
            <p class="eyebrow">
              {String(i + 1).padStart(2, '0')} · {s.category}
            </p>
            <h2 id={`${s.slug}-title`} style="margin-top: 0.75rem">
              <a href={`/services/${s.slug}/`}>{s.name}</a>
            </h2>
          </div>
          <div>
            <p>{s.definition}</p>
            {s.automated && (
              <p class="muted">
                Prefer it automated? <a href={`/products/${nexova.slug}/`}>{nexova.name} {s.automated.feature}</a>{' '}
                does this on its own.
              </p>
            )}
            <div class="actions" style="margin-top: 1.5rem">
              <a class="btn btn-solid" href={`/services/${s.slug}/`}>
                About {lcFirst(s.name)}
                <Icon name="arrow" />
              </a>
              <a class="btn btn-line" href={whatsappUrl(s)}>
                WhatsApp us
              </a>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section" aria-labelledby="auto-title">
    <div class="wrap section-grid">
      <div class="section-head">
        <h2 id="auto-title">Rather it ran itself?</h2>
      </div>
      <div>
        <p>
          {nexova.name} is our self-growing store website. It does the content, Meta ads and SEO work on its
          own, following the same workflows our team uses with clients.
        </p>
        <div class="actions" style="margin-top: 1.5rem">
          <a class="btn btn-solid" href={`/products/${nexova.slug}/`}>
            See {nexova.name}
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
