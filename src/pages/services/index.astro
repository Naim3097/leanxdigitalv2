---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Label from '../../components/Label.astro';
import DraftNote from '../../components/DraftNote.astro';
import MockCard from '../../components/MockCard.astro';
import ServiceStack from '../../components/ServiceStack.astro';
import { pageTitle } from '../../data/site';
import { showDrafts } from '../../lib/drafts';
import { services } from '../../data/services';
import { products } from '../../data/products';
import { updatedFor } from '../../data/pages';
import { webPage, breadcrumbs, serviceList } from '../../lib/schema';
import { countWord } from '../../lib/text';
import { serviceIcons } from '../../lib/icons';

const path = '/services/';
const count = countWord(services.length);
const nexova = products[0];
const title = pageTitle('Services: creative, paid ads, SEO and development');
const description =
  'Lean X Digital’s team does the work for you: a creative agency, paid advertising, SEO, and website, CRM and app development for Malaysian businesses.';
const crumbs: [string, string][] = [
  ['Home', '/'],
  ['Services', path],
];

const schema = [
  webPage({
    path,
    title,
    description,
    updated: updatedFor(path),
    type: 'CollectionPage',
    hasBreadcrumb: true,
  }),
  breadcrumbs(path, crumbs),
  serviceList(path),
];
---

<Base title={title} description={description} schema={schema}>
  <header class="page-head">
    <div class="glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <Label icon="users">Done for you</Label>
      <h1>Services</h1>
      <p class="lede">
        Our team does the work for you. {count.charAt(0).toUpperCase() + count.slice(1)} services, from the
        same team that builds {nexova.name}.
      </p>
      <ul class="jump">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`}>
                <Icon name={serviceIcons[s.slug] ?? 'spark'} />
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  {
    showDrafts && (
      <div class="container draft-wrap">
        <DraftNote label="Draft: proposed structure, for your decision">
          <p>
            The strategy report suggests ordering the services the way a buyer moves, from traffic to conversion to
            checkout to a store of their own, so the list stops reading like a generalist menu:
          </p>
          <ul>
            <li>Rename Paid advertising to performance marketing, reported in paid orders, and fold Creative agency into it</li>
            <li>
              Split Websites, CRM and apps into own store launch, landing pages and funnels, and checkout and payment
              integration, the last only after the payment lawyer’s answers
            </li>
            <li>Reframe SEO as search and AI visibility for online stores, at a lower priority</li>
            <li>Give the page a more descriptive H1 than “Services”, once you have keyword data</li>
          </ul>
          <p>Renamed pages change URLs. Before launch that costs nothing; after launch each one needs a redirect.</p>
        </DraftNote>
      </div>
    )
  }

  <div class="stack-wrap">
    <ServiceStack variant="full" titleTag="h2" />
  </div>

  <section class="section auto" aria-labelledby="auto-title">
    <div class="container">
      <div class="mesh-card auto-card" data-rise>
        <div class="auto-copy">
          <Label icon="spark">Automated</Label>
          <h2 id="auto-title" data-split>Rather it ran itself?</h2>
          <p>
            {nexova.name} is our self-growing store website. It does the content, Meta ads and SEO work on its
            own, following the same workflows our team uses with clients.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={`/products/${nexova.slug}/`} data-magnetic>See {nexova.name}</a>
          </div>
        </div>
        <div class="auto-visual" aria-hidden="true">
          <MockCard kind="poster" class="av av1" />
          <MockCard kind="ad" class="av av2" />
          <MockCard kind="search" class="av av3" />
          <MockCard kind="sync" class="av av4" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Page head: the four services as quick links under the lede */
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  /* Phones: one row that scrolls sideways, running to the screen edges */
  @media (max-width: 47.99rem) {
    .jump {
      justify-self: stretch;
      flex-wrap: nowrap;
      justify-content: flex-start;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0.25rem var(--gutter) 1rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
    }

    .jump::-webkit-scrollbar {
      display: none;
    }

    .jump li {
      flex: none;
      scroll-snap-align: start;
    }
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem 0.5rem 0.875rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: var(--paper);
    box-shadow: var(--shadow-chip);
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--fast), color var(--fast), transform var(--mid) var(--ease-out);
  }

  .jump a :global(svg) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--text-2);
    transition: color var(--fast);
  }

  .jump a:hover {
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-2px);
  }

  .jump a:hover :global(svg) {
    color: var(--paper);
  }

  /* The stacking service cards follow the page head */
  .stack-wrap {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .draft-wrap + .stack-wrap {
    padding-top: 0;
  }

  /* Rather it ran itself? Here the call to action's colour panel follows straight after, so this card is
     white, with the mesh as an inset panel holding sketches of what Nexova does */
  .auto {
    padding-bottom: 0;
  }

  /* overflow stays visible (an overflow container would freeze the heading's scroll-linked reveal) */
  .auto-card {
    gap: 0.75rem;
    overflow: visible;
    padding: 0.75rem;
    background: var(--paper);
    box-shadow: var(--shadow-card);
  }

  .auto-card::before,
  .auto-card::after {
    display: none;
  }

  .auto-copy {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(1.25rem, 0.5rem + 3vw, 4rem);
  }

  .auto-copy h2 {
    font-size: var(--fs-h2);
  }

  .auto-copy .actions {
    margin-top: 0.75rem;
  }

  .auto-visual {
    position: relative;
    justify-self: stretch;
    min-height: 15rem;
    overflow: hidden;
    border-radius: calc(var(--radius-xl) - 0.75rem);
    background:
      radial-gradient(70% 60% at 40% 45%, rgb(255 255 255 / 0.5), transparent 75%),
      var(--mesh);
    background-size: 100% 100%, 420% 100%;
    background-position: 0 0, 50% 0;
  }

  .auto-visual :global(.av) {
    position: absolute;
  }

  .auto-visual :global(.av1) {
    left: 6%;
    top: 12%;
    transform: rotate(-5deg);
  }

  .auto-visual :global(.av2) {
    right: 6%;
    top: 20%;
    transform: rotate(4deg);
  }

  .auto-visual :global(.av3),
  .auto-visual :global(.av4) {
    display: none;
  }

  @media (max-width: 34.99rem) {
    .auto-visual :global(.av) {
      zoom: 0.76;
    }
  }

  @media (min-width: 60rem) {
    .auto-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      min-height: 34rem;
    }

    .auto-visual {
      align-self: stretch;
      min-height: 30rem;
    }

    .auto-visual :global(.av1) {
      left: 8%;
      top: 9%;
    }

    .auto-visual :global(.av2) {
      right: 7%;
      top: 15%;
    }

    .auto-visual :global(.av3) {
      display: grid;
      left: 16%;
      bottom: 12%;
      transform: rotate(2deg);
    }

    .auto-visual :global(.av4) {
      display: grid;
      right: 8%;
      bottom: 7%;
      transform: rotate(-3deg);
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    @media (min-width: 30rem) {
      .auto-visual :global(.av) {
        animation: auto-bob 3s ease-in-out infinite alternate;
      }

      .auto-visual :global(.av2) {
        animation-duration: 3.6s;
        animation-delay: -1.2s;
      }

      .auto-visual :global(.av3) {
        animation-duration: 2.7s;
        animation-delay: -0.6s;
      }

      .auto-visual :global(.av4) {
        animation-duration: 3.3s;
        animation-delay: -2s;
      }

      @keyframes auto-bob {
        from {
          translate: -3px 6px;
        }

        to {
          translate: 3px -8px;
        }
      }
    }
  }
</style>
