---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import { site } from '../data/site';
---

<Base
  title={`Page not found | ${site.name}`}
  description="This page does not exist on the Lean X Digital website."
  noindex
>
  <section class="page-head notfound">
    <div class="glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <span class="big" aria-hidden="true">404</span>
    <div class="container">
      <Label icon="search">404</Label>
      <h1>This page is out of stock.</h1>
      <p class="lede">
        Sorry, this page isn’t here. It may have moved when we rebuilt the site.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/" data-magnetic>Home</a>
        <a class="btn btn-secondary" href="/products/" data-magnetic>Products</a>
        <a class="btn btn-secondary" href="/contact/" data-magnetic>Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* A centred hero like the page heads, tall enough to fill the first screen */
  .notfound {
    display: grid;
    align-items: center;
    min-height: min(100vh, 56rem);
  }

  @supports (min-height: 100svh) {
    .notfound {
      min-height: min(100svh, 56rem);
    }
  }

  .notfound h1 {
    font-size: clamp(2.5rem, 1.2rem + 4.6vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  /* Oversized numerals behind the text, fading into the page */
  .big {
    position: absolute;
    left: 50%;
    bottom: -0.16em;
    font-size: clamp(11rem, 6rem + 26vw, 30rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.06em;
    white-space: nowrap;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.15) 75%, rgb(255 255 255 / 0));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: translateX(-50%);
    pointer-events: none;
    user-select: none;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .big {
      animation: big-in 1.4s 0.15s var(--ease-out) both;
    }

    @keyframes big-in {
      from {
        opacity: 0;
        transform: translate(-50%, 0.12em);
      }
    }
  }

  /* Print would set the see-through numerals in solid black */
  @media (forced-colors: active), print {
    .big {
      display: none;
    }
  }

  /* Short windows (landscape phones): start near the top with tighter spacing, so the three buttons clear
     the nav pill */
  @media (max-height: 30rem) {
    .notfound {
      min-height: 0;
      padding-top: 4.5rem;
    }

    .notfound .container {
      gap: 1rem;
    }

    .notfound h1 {
      font-size: min(2.5rem, 10vh);
    }
  }
</style>
