---
import Base from '../../layouts/Base.astro';
import Label from '../../components/Label.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RowList from '../../components/RowList.astro';
import DraftNote from '../../components/DraftNote.astro';
import { pageTitle } from '../../data/site';
import { visibleCaseStudies, liveCaseStudies } from '../../data/work';
import { webPage, breadcrumbs } from '../../lib/schema';
import { workRows } from '../../lib/rows';

// /work/ is built only when there is a case study to show. In production that means one that is
// no longer a draft, so the live site never shows an empty or placeholder page.
export function getStaticPaths() {
  return visibleCaseStudies.length > 0 ? [{ params: { page: undefined } }] : [];
}

const path = '/work/';
const title = pageTitle('Client work and case studies');
const description =
  'Case studies from Lean X Digital’s client work: what we did and what came of it, with numbers and dates. Each is published with the client’s permission.';
const crumbs: [string, string][] = [
  ['Home', '/'],
  ['Work', path],
];
const updated = visibleCaseStudies.map((c) => c.updated).sort().at(-1) ?? '';

const schema = [
  webPage({ path, title, description, updated, type: 'CollectionPage', hasBreadcrumb: true }),
  breadcrumbs(path, crumbs),
];
---

<Base title={title} description={description} schema={schema} noindex={liveCaseStudies.length === 0}>
  <header class="page-head">
    <div class="glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <Label icon="briefcase">Work</Label>
      <h1>Client work</h1>
      <p class="lede">
        What we did for clients and what came of it, with numbers and dates. Each case study is published with the
        client’s permission.
      </p>
    </div>
  </header>

  <section class="section cases" aria-labelledby="list-title">
    <div class="container">
      <div class="intro">
        <h2 id="list-title" data-split>Case studies</h2>
      </div>
      {
        liveCaseStudies.length === 0 && (
          <div class="cases-note">
            <DraftNote label="Draft section">
              <p>
                This page goes live with the first real case study a client has approved. Until then it shows only in
                previews such as staging, and so does the menu link to it.
              </p>
            </DraftNote>
          </div>
        )
      }
      <div class="cases-panel" data-rise>
        <RowList items={workRows(visibleCaseStudies)} />
      </div>
    </div>
  </section>
</Base>

<style>
  .cases-note {
    max-width: var(--measure-4);
    margin-inline: auto;
  }

  .cases-note + .cases-panel {
    margin-top: 1.5rem;
  }

  /* The list sits on one white panel, like a card holding its rows */
  .cases-panel {
    padding: 0.5rem clamp(1.25rem, 0.5rem + 2.5vw, 3rem);
    border-radius: var(--radius-xl);
    background: var(--paper);
    box-shadow: var(--shadow-card);
  }

  .cases-panel :global(.rows) {
    border-top: 0;
  }

  .cases-panel :global(.rows li:last-child) {
    border-bottom: 0;
  }

  .cases-panel :global(.rows a) {
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }

  @media (max-width: 47.99rem) {
    .cases-panel {
      border-radius: var(--radius-m);
    }
  }
</style>
