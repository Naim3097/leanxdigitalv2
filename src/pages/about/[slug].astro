---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Facts from '../../components/Facts.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import Label from '../../components/Label.astro';
import DraftNote from '../../components/DraftNote.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { site, pageTitle } from '../../data/site';
import { people, hasProfilePage, profileReady, type Person } from '../../data/services';
import { updatedFor } from '../../data/pages';
import { webPage, breadcrumbs, person, personId } from '../../lib/schema';

// One page per strategist: Google's profile page markup is for a page about a single person.
// Built for production only once the profile has a real photo and a LinkedIn link.
export function getStaticPaths() {
  return people.filter(hasProfilePage).map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: Person };
const path = `/about/${m.slug}/`;
const ready = profileReady(m);
const title = pageTitle(`${m.fullName}: ${m.focus}`);
const description = `${m.fullName}, ${m.role} at ${site.name}. ${m.bio}`;
const updated = updatedFor('/about/');
const crumbs: [string, string][] = [
  ['Home', '/'],
  ['About', '/about/'],
  [m.name, path],
];
const linkedin = m.sameAs?.find((u) => u.includes('linkedin.com'));
// Stand-in for the headshot until one is supplied: the icon of the person's focus.
const focusIcon: IconName = /creative|meta/i.test(m.focus)
  ? 'pen'
  : /google|seo|search/i.test(m.focus)
    ? 'target'
    : 'users';
const facts: [string, string][] = [
  ['Name', m.fullName],
  ['Role', m.role],
  ['Focus', m.focus],
  ['Company', site.name],
];

const schema = [
  webPage({
    path,
    title,
    description,
    updated,
    type: 'ProfilePage',
    hasBreadcrumb: true,
    about: personId(m),
    mainEntity: personId(m),
  }),
  breadcrumbs(path, crumbs),
  person(m),
];
---

<Base title={title} description={description} schema={schema} noindex={!ready}>
  <article>
    <header class="page-head">
      <div class="glow" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="container">
        <Breadcrumbs items={crumbs} />
        {
          m.photo ? (
            <img class="head-face" src={m.photo} alt="" width="160" height="160" />
          ) : (
            <span class="head-face head-mono" aria-hidden="true">
              <Icon name={focusIcon} />
            </span>
          )
        }
        <Label icon="target">{m.focus}</Label>
        <h1>{m.name}</h1>
        <p class="lede">{m.role}.</p>
      </div>
    </header>

    {
      !ready && (
        <div class="narrow draft-wrap profile-draft">
          <DraftNote label="Draft profile page">
            <p>This page goes live once it has:</p>
            <ul>
              {!m.photo && <li>A real headshot, square, at least 800 × 800 px</li>}
              {!linkedin && <li>A link to their LinkedIn profile</li>}
              <li>If you have them: work they led, talks or articles, with links</li>
            </ul>
          </DraftNote>
        </div>
      )
    }

    <div class="section profile-body">
      <div class="container">
        <section class="duo" aria-labelledby="bio-title">
          <h2 id="bio-title" data-split>Background</h2>
          <div class="duo-text bio">
            <p>{m.bio}</p>
          </div>
        </section>

        <section class="duo" aria-labelledby="areas-title" data-rise>
          <h2 id="areas-title" data-split>Areas of work</h2>
          <ul class="pill-list areas">{m.knowsAbout.map((k) => <li>{k}</li>)}</ul>
        </section>

        {
          m.ownSite && (
            <section class="duo" aria-labelledby="elsewhere-title" data-rise>
              <h2 id="elsewhere-title" data-split>
                Elsewhere
              </h2>
              <div class="duo-text">
                <p>
                  {m.name} also shares how they work at{' '}
                  <a href={m.ownSite.url} rel="noopener">{m.ownSite.brand}</a>. {m.ownSite.disclaimer}
                </p>
              </div>
            </section>
          )
        }
      </div>
    </div>

    <div class="section section-white profile-sec">
      <div class="container">
        <aside class="profile-card" aria-labelledby="facts-title" data-rise>
          <div class="profile-photo">
            {
              m.photo ? (
                <img src={m.photo} alt={m.fullName} width="800" height="800" />
              ) : (
                <ImageSlot label={`Headshot of ${m.fullName}`} ratio="1 / 1" />
              )
            }
          </div>
          <div class="profile-info">
            <h2 id="facts-title">Profile</h2>
            <Facts facts={facts} />
            {
              m.sameAs && m.sameAs.length > 0 && (
                <div class="actions">
                  {m.sameAs.map((u) => (
                    <a class="btn btn-secondary btn-sm" href={u} rel="me noopener">
                      {new URL(u).hostname.replace('www.', '')}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>

<style>
  /* Page head: the headshot once supplied, a monogram until then */
  .head-face {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    box-shadow:
      0 0 0 4px var(--paper),
      var(--shadow-chip);
  }

  img.head-face {
    object-fit: cover;
  }

  .head-mono {
    display: grid;
    place-items: center;
    background: linear-gradient(140deg, var(--card-1), var(--card-2) 55%, var(--card-3));
    color: var(--paper);
  }

  .head-mono :global(svg) {
    width: 2.25rem;
    height: 2.25rem;
    stroke-width: 1.4;
  }

  .profile-draft {
    padding-top: 2.5rem;
  }

  .profile-draft + .profile-body {
    padding-top: var(--section-s);
  }

  .duo-text p + p {
    margin-top: 1rem;
  }

  /* The bio is the page's main text: one step larger and darker than other explainers */
  .bio p {
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: var(--text);
  }

  .areas li {
    padding: 0.625rem 1.125rem;
    border-color: var(--line-soft);
    box-shadow: var(--shadow-chip);
    color: var(--ink);
  }

  .duo-text a {
    color: var(--ink);
    text-decoration-thickness: 1.5px;
  }

  /* Profile: photo and the facts side by side, in one card */
  .profile-card {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    border-radius: var(--radius-xl);
    background: var(--page);
  }

  @media (min-width: 48rem) {
    .profile-card {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      align-items: center;
    }
  }

  .profile-photo {
    width: 100%;
    max-width: 22rem;
  }

  .profile-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-l);
    object-fit: cover;
  }

  .profile-photo :global(.image-slot) {
    border-radius: var(--radius-l);
  }

  .profile-info {
    display: grid;
    gap: 1.5rem;
    padding: clamp(0.5rem, 0.25rem + 1vw, 1.5rem) clamp(0.5rem, 0.25rem + 1vw, 1.5rem) clamp(0.75rem, 0.5rem + 1vw, 1.5rem) 0;
  }

  @media (max-width: 47.99rem) {
    .profile-info {
      padding: 0 0.5rem 0.75rem;
    }
  }

  .profile-info h2 {
    font-size: var(--fs-h3);
  }

  /* Narrow screens: each term sits above its value */
  @media (max-width: 35.99rem) {
    .profile-info :global(.facts div) {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .profile-info .actions {
    margin-top: 0.25rem;
  }
</style>
