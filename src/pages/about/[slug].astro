---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Facts from '../../components/Facts.astro';
import DraftNote from '../../components/DraftNote.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { site, pageTitle } from '../../data/site';
import { people, hasProfilePage, profileReady, type Person } from '../../data/services';
import { updatedFor } from '../../data/pages';
import { webPage, breadcrumbs, person, personId } from '../../lib/schema';

// One page per strategist: Google's profile page markup is for a page about a single person.
// Built for production only once the profile has a real photo and a LinkedIn link.
export function getStaticPaths() {
  return people.filter(hasProfilePage).map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: Person };
const path = `/about/${m.slug}/`;
const ready = profileReady(m);
const title = pageTitle(`${m.fullName}: ${m.focus}`);
const description = `${m.fullName}, ${m.role} at ${site.name}. ${m.bio}`;
const updated = updatedFor('/about/');
const crumbs: [string, string][] = [
  ['Home', '/'],
  ['About', '/about/'],
  [m.name, path],
];
const linkedin = m.sameAs?.find((u) => u.includes('linkedin.com'));
const facts: [string, string][] = [
  ['Name', m.fullName],
  ['Role', m.role],
  ['Focus', m.focus],
  ['Company', site.name],
];

const schema = [
  webPage({
    path,
    title,
    description,
    updated,
    type: 'ProfilePage',
    hasBreadcrumb: true,
    about: personId(m),
    mainEntity: personId(m),
  }),
  breadcrumbs(path, crumbs),
  person(m),
];
---

<Base title={title} description={description} schema={schema} noindex={!ready}>
  <Breadcrumbs items={crumbs} />

  <article>
    <header class="page-head wrap">
      <p class="eyebrow">{m.focus}</p>
      <h1>{m.name}</h1>
      <p class="lede">{m.role}.</p>
    </header>

    <div class="wrap product-body">
      <div class="prose">
        {
          !ready && (
            <DraftNote label="Draft profile page">
              <p>This page goes live once it has:</p>
              <ul>
                {!m.photo && <li>A real headshot, square, at least 800 × 800 px</li>}
                {!linkedin && <li>A link to their LinkedIn profile</li>}
                <li>If you have them: work they led, talks or articles, with links</li>
              </ul>
            </DraftNote>
          )
        }

        <section aria-labelledby="bio-title">
          <h2 id="bio-title">Background</h2>
          <p>{m.bio}</p>
        </section>

        <section aria-labelledby="areas-title">
          <h2 id="areas-title">Areas of work</h2>
          <ul class="inline-list">{m.knowsAbout.map((k) => <li>{k}</li>)}</ul>
        </section>

        {
          m.ownSite && (
            <section aria-labelledby="elsewhere-title">
              <h2 id="elsewhere-title">Elsewhere</h2>
              <p>
                {m.name} also shares how they work at{' '}
                <a href={m.ownSite.url} rel="noopener">
                  {m.ownSite.brand}
                </a>
                . {m.ownSite.disclaimer}
              </p>
            </section>
          )
        }
      </div>

      <aside class="product-aside" aria-labelledby="facts-title">
        {
          m.photo ? (
            <img src={m.photo} alt={m.fullName} width="800" height="800" />
          ) : (
            <ImageSlot label={`Headshot of ${m.fullName}`} ratio="1 / 1" />
          )
        }
        <h2 id="facts-title" style="margin-top: 1.5rem">Profile</h2>
        <Facts facts={facts} />
        {
          m.sameAs && m.sameAs.length > 0 && (
            <div class="actions" style="margin-top: 1.5rem">
              {m.sameAs.map((u) => (
                <a class="btn btn-line" href={u} rel="me noopener">
                  {new URL(u).hostname.replace('www.', '')}
                </a>
              ))}
            </div>
          )
        }
      </aside>
    </div>
  </article>
</Base>
